{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/HealthSphere_AI/backend" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/HealthSphere_AI/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Docker Up",
      "type": "shell",
      "command": "docker compose up --build",
      "options": { "cwd": "${workspaceFolder}/HealthSphere_AI" },
      "problemMatcher": []
    }
  ]
}
